# ============================================================================
# TAROT COUPLE — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Sao chép file này thành `.env.local` khi chạy Local hoặc cấu hình trên Vercel
# ============================================================================

# 1. URL Trang Web Chính Thức (Dùng cho Sitemap, Robots.txt, Canonical & OG Image)
NEXT_PUBLIC_SITE_URL="https://tarotcouple.vercel.app"

# 2. Google Gemini AI Engine (Structured JSON Output Schema)
# Hỗ trợ Multi-Key Pool (Round-Robin & Tự động Failover nếu 1 key hết quota/429)
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3="" ... lên tới GEMINI_API_KEY_10 (hoặc dạng phẩy trong GEMINI_API_KEYS)
GEMINI_MODEL="gemini-3.5-flash-lite"

# 3. Cổng Thanh Toán VietQR Động — PayOS (Sprint 2 P18)
# Nếu để trống ở Local, hệ thống tự động tạo mã VietQR Sandbox & cho phép xác nhận thử nghiệm
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# 4. Cơ Sở Dữ Liệu Supabase PostgreSQL + RLS (Hybrid Mode)
# Chạy script `supabase/migrations/001_tarot_couple_golive_schema.sql` trong Supabase SQL Editor.
# Nếu để trống, ứng dụng chạy mượt ở chế độ In-Memory Store (không cần cài DB khi dev/test).
NEXT_PUBLIC_SUPABASE_URL="https://zyenwgmdghxyrwnniwkv.supabase.co"
