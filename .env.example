# ============================================================================
# TAROT COUPLE — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Sao chép file này thành `.env.local` khi chạy Local hoặc cấu hình trên Vercel
# ============================================================================

# 1. URL Trang Web Chính Thức (Dùng cho Sitemap, Robots.txt, Canonical & OG Image)
NEXT_PUBLIC_SITE_URL="https://tarotcouple.vercel.app"

# 2. Google Gemini AI Engine (Structured JSON Output Schema)
# Hỗ trợ Multi-Key Pool (Round-Robin & Tự động Failover nếu 1 key hết quota/429)
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3="" ... lên tới GEMINI_API_KEY_10 (hoặc dạng phẩy trong GEMINI_API_KEYS)
GEMINI_MODEL="gemini-3.5-flash-lite"

# 3. Cổng Thanh Toán VietQR Động — PayOS (Sprint 2 P18)
# BẮT BUỘC để nhận webhook thật. Thiếu PAYOS_CHECKSUM_KEY => webhook bị từ chối (fail-closed).
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Chỉ bật khi chạy local để giả lập webhook. KHÔNG BAO GIỜ bật ở production.
PAYOS_SANDBOX="false"

# 4. Cơ Sở Dữ Liệu Supabase PostgreSQL + RLS (Hybrid Mode)
# Chạy script `supabase/migrations/001_tarot_couple_golive_schema.sql` trong Supabase SQL Editor.
# Nếu để trống, ứng dụng chạy mượt ở chế độ In-Memory Store (không cần cài DB khi dev/test).
# TUYỆT ĐỐI không commit key thật. service_role bypass toàn bộ RLS — chỉ đặt trên server/Vercel.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# 5. Bảo mật phiên & Admin (Phase 1)
# SESSION_SECRET: chuỗi ngẫu nhiên >= 32 ký tự, dùng ký HMAC cookie `tc_sid`.
#   Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Thiếu biến này ở production => mỗi instance dùng secret tạm riêng (session không ổn định).
SESSION_SECRET=""
# ADMIN_SECRET: thiếu biến này => toàn bộ /admin và số liệu nội bộ bị khoá (fail-closed).
ADMIN_SECRET=""

# 6. Chế độ Bảo trì Hệ Thống (Maintenance Mode)
# Đặt thành "true" trên Vercel để kích hoạt trang bảo trì cho toàn bộ người dùng
MAINTENANCE_MODE="false"
# Mã bí mật để Admin bypass vào web kiểm tra khi đang bảo trì: /?bypass=<token>
# Thiếu biến này => tính năng bypass bị tắt hoàn toàn.
MAINTENANCE_BYPASS_TOKEN=""
